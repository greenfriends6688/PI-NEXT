# Electron's postinstall downloads its ~100 MB binary from github.com. Some networks
# cannot reach it at all — the install then fails with `fetch failed` and no hint about
# why. This points that one download at a mirror; everything else still comes from the
# registry. Delete this file (or the line) if GitHub is reachable where you build.
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
