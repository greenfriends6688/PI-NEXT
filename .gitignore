/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
e2e_*.mjs

# electron-builder output (upstream desktop target)
/release

# fork: 本地产物不进仓库（验证截图、发布包、参考项目、本地工具目录）
/*.png
/*.zip
/.playwright-mcp/
/.workbuddy/
/.workbuddy-ai/
/pi参考项目/

# fork: 第三方参考项目不进仓库（只留本地；原文件里那几行中文路径是乱码，匹配不上真实目录名）
/参考项目/
/pi参考项目/
/家里电脑跑的/

# fork: Electron 打包资源要进仓库 —— package.json 的 build 配置与 extraResources 引用它们，
# 忽略掉会让别人 clone 后无法 npm run desktop:dist（图标/托盘图缺失）
!/build/
!/build/*.png
# fork: 规划/对比类文档只留本地，不进仓库（对齐用户的"docs 里的规划文档不用传"）
/docs/beautifului-*
/docs/proma-*
/docs/boardui-*
/docs/shadcn-*
/docs/musepi-*
/docs/desktop-ui-*
