{
  "name": "@agegr/pi-web",
  "version": "0.1.6",
  "description": "PI NEXT — local coding agent workbench",
  "homepage": "https://github.com/greenfriends6688/Pi-Agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenfriends6688/Pi-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/greenfriends6688/Pi-Agent/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "//browserslist": "Next 16 compiles for Safari 16.4+ by default and leaves class `static {}` blocks alone; Safari 16.2 rejects the App Router runtime chunk outright (#753). Keep the other entries at Next's defaults (node_modules/next/dist/shared/lib/modern-browserslist-target.js).",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.mjs",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node bin/prepare-terminal.js",
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:clean": "node scripts/next-mode.mjs dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "prod": "node scripts/next-mode.mjs prod",
    "mode:status": "node scripts/next-mode.mjs status",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:themes": "node e2e/themes.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\" \"electron/**/*.test.mjs\"",
    "check:styles": "node scripts/check-style-literals.mjs",
    "check:motion": "node scripts/check-motion-tokens.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:contrast": "node docs/codex-skin/check-contrast.mjs",
    "verify:boards": "node scripts/verify-against-boards.mjs && node scripts/board-diff-all.mjs",
    "verify:boards:seeded": "node scripts/verify-boards-live.mjs",
    "check:design": "node scripts/check-style-literals.mjs && node scripts/check-motion-tokens.mjs && node scripts/check-icons.mjs && node design/pi-web-design/scripts/check-boards.mjs && node design/pi-web-design/scripts/check-align.mjs",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "desktop": "electron .",
    "desktop:verify": "node scripts/verify-desktop-bundle.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:dist": "npm run build && npm run desktop:verify && electron-builder",
    "desktop:dist:win": "npm run build && npm run desktop:verify && electron-builder --win",
    "desktop:icons": "node scripts/gen-icons.mjs",
    "test:fileviewer": "node e2e/file-viewer-modes.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "^5.2.3",
    "next": "16.3.6",
    "node-diff3": "^3.2.1",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "semver": "7.8.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "8.11.0",
    "unified": "^11.0.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "productName": "PI NEXT",
  "main": "electron/main.js",
  "build": {
    "appId": "com.greenfriends6688.pinkslab",
    "productName": "PI NEXT",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "**/*",
      "!e2e/**",
      "!docs/**",
      "!release/**",
      "!test-results/**",
      "!**/*.map",
      "!**/*.test.*",
      "!**/*.tsbuildinfo",
      "!**/tsconfig.json",
      "!**/.DS_Store",
      "!.next/cache/**",
      "!node_modules/@esbuild/**",
      "!node_modules/esbuild/**",
      "!node_modules/@resvg/**",
      "!node_modules/.bin/**",
      "!node_modules/**/{test,tests,__tests__,example,examples,docs}/**",
      "!.context/**",
      "!node_modules/**/*.{md,markdown,ts,map}",
      "!node_modules/{typescript,eslint,prettier,tailwindcss,postcss,autoprefixer}/**",
      "!**/node_modules/@next/swc-*/**",
      "!**/node_modules/caniuse-lite/**",
      "!**/node_modules/@img/**",
      "!pi参考项目/**",
      "!设计风格/**",
      "!pi-codex-release/**",
      "!pi-web-pr-inbox/**",
      "!.playwright-mcp/**",
      "!assets/**",
      "!.workbuddy/**",
      "!.workbuddy-ai/**",
      "!家里电脑跑的/**",
      "!*.png",
      "!*.jpg",
      "!*.jpeg",
      "!*.zip",
      "!*.log",
      "!*.tar.gz",
      "!*.dmg"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "12.0",
      "x64ArchFiles": "**/Resources/app/node_modules/**",
      "electronLanguages": [
        "en",
        "zh_CN",
        "zh_TW"
      ],
      "target": [
        "dir",
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "electronLanguages": [
        "en-US",
        "zh-CN",
        "zh-TW",
        "ja",
        "ru",
        "de",
        "fr",
        "es",
        "ko"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PI NEXT",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "PI NEXT ${version}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "assets/default-skills",
        "to": "default-skills"
      },
      {
        "from": "build/icon.png",
        "to": "appIcon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "afterPack": "scripts/after-pack.mjs"
  }
}
