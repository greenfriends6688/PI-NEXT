{
  "name": "@pinext/cloud",
  "version": "1.0.0",
  "private": true,
  "description": "PI NEXT 的云端服务：账号登录、设备登记、WebRTC 信令中转",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "DEV_LOGIN=1 PUBLIC_ORIGIN=http://127.0.0.1:9088 node src/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.5.12",
    "typescript": "^5.7.0"
  }
}
